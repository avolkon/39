# Пути (относительно корня репозитория или абсолютные)
CHEM_DATA_DIR=ml/data
CHEM_MODELS_DIR=ml/models_saved
CHEM_SUBMISSIONS_DIR=docs/submissions

CHEM_RANDOM_SEED=42
CHEM_N_FOLDS=5
CHEM_N_CLUSTERS=5
CHEM_LOG_TRANSFORM_IC50_CC50=true
CHEM_MISSING_THRESHOLD=0.3
CHEM_USE_NEURAL_NET=false
CHEM_USE_OPTUNA=false
# Фаза 0: OOF stacking второго уровня (RidgeCV на OOF базовых моделей)
CHEM_USE_STACKING=false
